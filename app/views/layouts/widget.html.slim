doctype html
html lang=I18n.locale dir=(I18n.locale.to_s.match?(/^(ar|he|fa|ur)/i) ? "rtl" : "ltr")
  head
    title = content_for(:title) || "Deskbolic Widget"
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="apple-mobile-web-app-capable" content="yes"
    meta name="mobile-web-app-capable" content="yes"
    = csrf_meta_tags
    = csp_meta_tag
    = action_cable_meta_tag

    = yield :head

    = favicon_link_tag(image_path("fav_icon.png"))
    = favicon_link_tag(image_path("fav_icon.png"), rel: "apple-touch-icon")

    - widget_asset_version = "20260809-category-icon-theme-v1"
    link rel="stylesheet" href="#{asset_path('application.css')}?v=#{widget_asset_version}" data-turbo-track="reload"
    script type="module" src="#{asset_path('application.js')}?v=#{widget_asset_version}" data-turbo-track="reload"

    / Dynamic theme from widget or form configurations
    - theme_color = @widget&.theme_color || @form&.theme_color || @form&.ui_configurations&.dig("theme_color") || @form&.configurations&.dig("primary_color")
    - if theme_color.present?
      css:
        :root {
          --widget-primary-color: #{theme_color};
        }
        .start-conv-btn, #deskbolic-bubble, .btn-primary, .client-reply, .header-1 { background: #{theme_color} !important; }
        .footer .active, .reply-time .time, .team { color: #{theme_color} !important; }
        .theme-svg path { fill: #{theme_color} !important; stroke: white !important; }

    - if @form&.custom_css.present?
      style = @form.custom_css.html_safe

    css:
      /* Iframe constraint overrides */
      body { margin: 0; padding: 0; overflow: hidden; background: transparent; }
      #deskbolic-widget {
        position: static !important;
        width: 100% !important;
        height: 100vh !important;
      }
      #deskbolic-widget .chat-screen {
        width: 100% !important;
        height: 100% !important;
      }
      #deskbolic-widget .homepage,
      #deskbolic-widget .messages-page,
      #deskbolic-widget .chat-box {
        margin: 0 !important;
        height: 100% !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        width: 100% !important;
        max-width: 100% !important;
      }

      body.contact-form-embed {
        overflow: hidden !important;
      }
      body.contact-form-embed #deskbolic-widget,
      body.contact-form-embed #deskbolic-widget .chat-screen,
      body.contact-form-embed #deskbolic-widget .chat-box {
        height: auto !important;
        min-height: 0 !important;
      }
      body.contact-form-embed #deskbolic-widget .chat-box {
        overflow: visible !important;
      }

  - is_contact_form = @form.present? || params[:controller] == "contact_forms"
  - body_classes = [("contact-form-embed" if is_contact_form), ("has-border" if is_contact_form && params[:bordered].present?)].compact.join(" ")
  body class=body_classes.presence data-controller="live-preview"
    - widget_customer_session_token_storage_key = @account && @widget ? "deskbolic:customer-session-token:#{@account.id}:#{@widget.id}" : nil
    - if widget_customer_session_token_storage_key.present? && @customer
      javascript:
        (function() {
          try {
            window.localStorage.setItem(#{widget_customer_session_token_storage_key.to_json.html_safe}, #{customer_session_token.to_json.html_safe});
          } catch (error) {}
          if (window.parent !== window) {
            window.parent.postMessage({ type: "deskbolic:customer", customer_session_token: #{customer_session_token.to_json.html_safe} }, "*");
          }
        })();

    #deskbolic-widget
      = yield

    / Branding footer
    - if @widget&.account&.feature_enabled?(:custom_branding) && @widget&.custom_branding?
      - custom_text = @widget&.ui_configurations&.dig("footer_text")
      - if custom_text.present?
        .powered-by
          span = custom_text
    - else
      .powered-by
        a href="https://deskbolic.com" target="_blank" rel="noopener"
          | Powered by Deskbolic

    - if @form.present? || params[:controller] == "contact_forms"
      javascript:
        (function() {
          function measureContactForm() {
            var container = document.querySelector(".contact-form-container");
            var height = container ? Math.ceil(container.getBoundingClientRect().height) : Math.max(
              document.body.scrollHeight,
              document.documentElement.scrollHeight,
              document.body.offsetHeight,
              document.documentElement.offsetHeight
            );

            var totalHeight = Math.ceil(height) + 16;

            window.parent.postMessage({
              type: "deskbolic:contact-form:resize",
              height: totalHeight,
              form_id: "#{@form&.id}"
            }, "*");
          }

          window.addEventListener("load", function() {
            measureContactForm();
            window.parent.postMessage({
              type: "deskbolic:contact-form:ready",
              form_id: "#{@form&.id}"
            }, "*");
          });
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(measureContactForm);
          }
          window.addEventListener("resize", measureContactForm);
          window.addEventListener("message", function(event) {
            if (!event.data || event.data.type !== "deskbolic:contact-form:measure") return;
            measureContactForm();
          });

          if ("ResizeObserver" in window) {
            new ResizeObserver(measureContactForm).observe(document.body);
          }

          requestAnimationFrame(measureContactForm);
        })();

