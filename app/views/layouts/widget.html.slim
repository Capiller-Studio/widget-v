doctype html
html lang=I18n.locale dir=(I18n.locale.to_s.match?(/^(ar|he|fa|ur)/i) ? "rtl" : "ltr")
  head
    title = content_for(:title) || "Deskbolic Widget"
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="apple-mobile-web-app-capable" content="yes"
    meta name="mobile-web-app-capable" content="yes"
    = csrf_meta_tags
    = csp_meta_tag
    = action_cable_meta_tag

    = yield :head

    = favicon_link_tag(image_path("fav_icon.png"))
    = favicon_link_tag(image_path("fav_icon.png"), rel: "apple-touch-icon")

    - widget_asset_version = "20260809-category-icon-theme-v1"
    link rel="stylesheet" href="#{asset_path('application.css')}?v=#{widget_asset_version}" data-turbo-track="reload"
    script type="module" src="#{asset_path('application.js')}?v=#{widget_asset_version}" data-turbo-track="reload"

    / Dynamic theme from widget or form configurations
    - theme_color = @widget&.theme_color || @form&.theme_color || @form&.ui_configurations&.dig("theme_color") || @form&.configurations&.dig("primary_color")
    - if theme_color.present?
      css:
        :root {
          --widget-primary-color: #{theme_color};
        }
        .start-conv-btn, #deskbolic-bubble, .btn-primary, .client-reply, .header-1 { background: #{theme_color} !important; }
        .footer .active, .reply-time .time, .team { color: #{theme_color} !important; }
        .theme-svg path { fill: #{theme_color} !important; stroke: white !important; }

    - if @form&.custom_css.present?
      style = @form.custom_css.html_safe

    css:
      /* Iframe constraint overrides */
      body { margin: 0; padding: 0; overflow: hidden; background: transparent; }
      #deskbolic-widget {
        position: static !important;
        width: 100% !important;
        height: 100vh !important;
      }
      #deskbolic-widget .chat-screen {
        width: 100% !important;
        height: 100% !important;
      }
      #deskbolic-widget .homepage,
      #deskbolic-widget .messages-page,
      #deskbolic-widget .chat-box {
        margin: 0 !important;
        height: 100% !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        width: 100% !important;
        max-width: 100% !important;
      }

      body.contact-form-embed {
        overflow: hidden !important;
      }
      body.contact-form-embed #deskbolic-widget,
      body.contact-form-embed #deskbolic-widget .chat-screen,
      body.contact-form-embed #deskbolic-widget .chat-box {
        height: auto !important;
        min-height: 0 !important;
      }
      body.contact-form-embed #deskbolic-widget .chat-box {
        overflow: visible !important;
      }

  - is_contact_form = @form.present? || params[:controller] == "contact_forms"
  - body_classes = [("contact-form-embed" if is_contact_form), ("has-border" if is_contact_form && params[:bordered].present?)].compact.join(" ")
  body class=body_classes.presence data-controller="live-preview"
    - if @account && @widget
      javascript:
        (function() {
          var customerToken = #{customer_session_token.to_json.html_safe};
          var accountId = "#{@account.id}";
          var widgetId = "#{@widget.id}";
          var storageKey = "deskbolic:customer-session-token:" + accountId + ":" + widgetId;

          if (customerToken) {
            try { window.localStorage.setItem(storageKey, customerToken); } catch (e) {}
            if (window.parent !== window) {
              window.parent.postMessage({ type: "deskbolic:customer", customer_session_token: customerToken }, "*");
            }
          } else if (window.parent !== window) {
            // Request token from host parent page (bi-directional token handshake)
            window.parent.postMessage({ type: "deskbolic:request_token" }, "*");
          }

          // Handle bi-directional messages from parent host page
          window.addEventListener("message", function(event) {
            var data = event.data;
            if (!data || !data.type) return;

            if (data.type === "deskbolic:token_response" && data.customer_session_token && !customerToken) {
              var currentUrl = new URL(window.location.href);
              if (!currentUrl.searchParams.has("customer_session_token")) {
                currentUrl.searchParams.set("customer_session_token", data.customer_session_token);
                window.location.replace(currentUrl.toString());
              }
            } else if (data.type === "deskbolic:set-customer" && data.customer) {
              var identifyUrl = "#{widget_identify_path(widget_route_params(customer_session_token: nil))}";
              var formData = new FormData();
              if (data.customer.identifier) formData.append("identifier", data.customer.identifier);
              if (data.customer.signature)  formData.append("signature", data.customer.signature);
              if (data.customer.email)      formData.append("email", data.customer.email);
              if (data.customer.name)       formData.append("name", data.customer.name);
              if (data.customer.avatar_url) formData.append("avatar_url", data.customer.avatar_url);

              fetch(identifyUrl, {
                method: "POST",
                headers: {
                  "Accept": "text/vnd.turbo-stream.html",
                  "X-CSRF-Token": document.querySelector("meta[name='csrf-token']") ? document.querySelector("meta[name='csrf-token']").content : ""
                },
                body: formData
              }).then(function(res) {
                return res.text();
              }).then(function(html) {
                if (typeof Turbo !== "undefined") {
                  Turbo.renderStreamMessage(html);
                } else {
                  window.location.reload();
                }
              }).catch(function(err) {
                console.error("[Deskbolic] Identify error:", err);
              });
            } else if (data.type === "deskbolic:reset") {
              try { window.localStorage.removeItem(storageKey); } catch (e) {}
              var rootUrl = "#{widget_root_path(widget_route_params(customer_session_token: nil))}";
              window.location.replace(rootUrl);
            } else if (data.type === "deskbolic:set-locale" && data.locale) {
              var url = new URL(window.location.href);
              var parts = url.pathname.split("/").filter(Boolean);
              if (parts.length > 0 && (parts[0].length === 2 || parts[0].includes("-"))) {
                parts[0] = data.locale;
              } else {
                parts.unshift(data.locale);
              }
              url.pathname = "/" + parts.join("/");
              window.location.replace(url.toString());
            }
          });
        })();

    #deskbolic-widget
      = yield

    / Branding footer
    - if @widget&.account&.feature_enabled?(:custom_branding) && @widget&.custom_branding?
      - custom_text = @widget&.ui_configurations&.dig("footer_text")
      - if custom_text.present?
        .powered-by
          span = custom_text
    - else
      .powered-by
        a href="https://deskbolic.com" target="_blank" rel="noopener"
          | Powered by Deskbolic

    - if @form.present? || params[:controller] == "contact_forms"
      javascript:
        (function() {
          function measureContactForm() {
            var container = document.querySelector(".contact-form-container");
            var height = container ? Math.ceil(container.getBoundingClientRect().height) : Math.max(
              document.body.scrollHeight,
              document.documentElement.scrollHeight,
              document.body.offsetHeight,
              document.documentElement.offsetHeight
            );

            var totalHeight = Math.ceil(height) + 16;

            window.parent.postMessage({
              type: "deskbolic:contact-form:resize",
              height: totalHeight,
              form_id: "#{@form&.id}"
            }, "*");
          }

          window.addEventListener("load", function() {
            measureContactForm();
            window.parent.postMessage({
              type: "deskbolic:contact-form:ready",
              form_id: "#{@form&.id}"
            }, "*");
          });
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(measureContactForm);
          }
          window.addEventListener("resize", measureContactForm);
          window.addEventListener("message", function(event) {
            if (!event.data || event.data.type !== "deskbolic:contact-form:measure") return;
            measureContactForm();
          });

          if ("ResizeObserver" in window) {
            new ResizeObserver(measureContactForm).observe(document.body);
          }

          requestAnimationFrame(measureContactForm);
        })();

