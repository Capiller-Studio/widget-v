(function() {
  "use strict";

  var WIDGET_HOST = "<%= request.base_url %>";
  var ACCOUNT_ID  = "<%= @account_id %>";
  var FORM_ID     = "<%= @form_id %>";

  // Read configuration from the script tag's data attributes
  var scriptTag = document.currentScript;
  var locale     = scriptTag.getAttribute("data-locale") || "en";
  var identifier = scriptTag.getAttribute("data-identifier") || "";
  var signature  = scriptTag.getAttribute("data-signature") || "";
  var email      = scriptTag.getAttribute("data-email") || "";
  var name       = scriptTag.getAttribute("data-name") || "";

  // Build the iframe src
  var src = WIDGET_HOST + "/" + locale + "/f/" + ACCOUNT_ID + "/" + FORM_ID;
  var params = [];
  if (identifier) params.push("identifier=" + encodeURIComponent(identifier));
  if (signature)  params.push("signature=" + encodeURIComponent(signature));
  if (email)      params.push("email=" + encodeURIComponent(email));
  if (name)       params.push("name=" + encodeURIComponent(name));
  if (params.length > 0) src += "?" + params.join("&");

  // Create iframe
  var iframe = document.createElement("iframe");
  iframe.src = src;
  iframe.style.cssText = "width:100%;height:0;min-height:0;max-height:calc(100vh - 32px);border:0;border-radius:12px;background:#fff;box-shadow:none;visibility:hidden;overflow:hidden;";
  iframe.setAttribute("allow", "microphone; camera");
  iframe.title = "Contact Form";

  // Insert iframe right after the script tag
  scriptTag.parentNode.insertBefore(iframe, scriptTag.nextSibling);

  var hasMeasured = false;

  function revealIframe() {
    if (hasMeasured) return;

    hasMeasured = true;
    iframe.style.visibility = "visible";
    iframe.style.border = "1px solid #e2e8f0";
    iframe.style.boxShadow = "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)";
  }

  function resizeIframe(contentHeight) {
    if (!contentHeight || contentHeight < 0) return;

    var viewportLimit = Math.max(320, window.innerHeight - 32);
    var nextHeight = Math.min(Math.ceil(contentHeight), viewportLimit);

    iframe.style.height = nextHeight + "px";
    iframe.style.overflow = contentHeight > viewportLimit ? "auto" : "hidden";
    revealIframe();
  }

  window.addEventListener("message", function(event) {
    if (event.source !== iframe.contentWindow) return;
    if (!event.data || event.data.type !== "deskbolic:contact-form:resize") return;

    resizeIframe(event.data.height);
  });

  window.addEventListener("resize", function() {
    try {
      iframe.contentWindow.postMessage({ type: "deskbolic:contact-form:measure" }, WIDGET_HOST);
    } catch (error) {
      // Cross-origin failures should not break the host page.
    }
  });

  window.setTimeout(function() {
    if (hasMeasured) return;

    iframe.style.height = "320px";
    iframe.style.overflow = "auto";
    revealIframe();
  }, 2000);
})();
