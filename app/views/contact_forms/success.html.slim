.chat-screen
  .chat-header
    h3 = @form.name

  .chat-box style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; text-align: center; padding: 40px 20px;"
    = inline_svg_tag("check_circle.svg", class: "success-icon", style: "width: 64px; height: 64px; color: var(--widget-primary-color); margin-bottom: 20px;")
    
    h2 style="font-size: 20px; font-weight: 600; color: #1e293b; margin-bottom: 10px;"
      = I18n.t("contact_form.success_title", default: "Message Sent!")
      
    p style="font-size: 15px; color: #64748b; line-height: 1.5;"
      = @success_message
