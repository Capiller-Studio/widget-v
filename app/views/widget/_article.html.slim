.chat-screen.widget-article-detail-page
  .homepage
    .widget-hero.widget-hero--article
      .widget-hero-top
        .widget-article-detail-back
          = button_to widget_help_category_path(widget_route_params(category_id: @category.id, format: :turbo_stream)), method: :get, class: "widget-article-detail-back-btn", form: { data: { turbo_stream: true } } do
            = inline_svg_tag("back_arrow.svg", class: "widget-article-detail-back-icon")
        button.widget-close-btn type="button" aria-label="Close"
          | ×
      .widget-hero-content
        .widget-article-breadcrumb
          = link_to widget_root_path(widget_route_params(format: :turbo_stream)), data: { turbo_stream: true } do
            = t('widget.footer.home', default: "Home")
          span.widget-article-breadcrumb-sep ›
          = link_to widget_help_category_path(widget_route_params(category_id: @category.id, format: :turbo_stream)), data: { turbo_stream: true } do
            = @category.name.presence || t('widget.help_center.untitled', default: "Untitled")
          span.widget-article-breadcrumb-sep ›
          span.widget-article-breadcrumb-current = @article.title.presence || t('widget.help_center.untitled', default: "Untitled")
        h1.widget-hero-title = @article.title.presence || t('widget.help_center.untitled', default: "Untitled")
        .widget-article-meta
          span = "Updated #{time_ago_in_words(@article.updated_at)} ago"
          span.widget-article-meta-dot ·
          span = t('widget.help_center.read_time_value', count: article_read_minutes(@article), default: "#{article_read_minutes(@article)} min read")

    .widget-content-sheet.widget-article-content

      .widget-article-body
        - content = @article.content.to_s
        - if content.present?
          = sanitize(content, tags: %w(p b i em strong s strike span code pre ul ol li br a h1 h2 h3 h4 h5 h6 img figure figcaption blockquote table thead tbody tr th td), attributes: %w(class style href target rel dir spellcheck src alt width height))
        - else
          p = t('widget.help_center.no_content', default: "This article has no content yet.")
