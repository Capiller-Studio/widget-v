.widget-footer-nav
  = link_to widget_home_path(widget_route_params(format: :turbo_stream)), class: "widget-footer-nav-btn #{active[:home]}", data: { turbo_stream: true } do
    span.widget-footer-nav-icon
      = inline_svg_tag("home.svg", class: "svg-icon")

  = link_to widget_conversations_path(widget_route_params(format: :turbo_stream)), class: "widget-footer-nav-btn #{active[:message]}", data: { turbo_stream: true } do
    span.widget-footer-nav-icon
      = inline_svg_tag("message.svg", class: "svg-icon")

  - if @widget.help_center_enabled?
    = link_to widget_help_center_path(widget_route_params(format: :turbo_stream)), class: "widget-footer-nav-btn #{active[:help]}", data: { turbo_stream: true } do
      span.widget-footer-nav-icon
        = inline_svg_tag("search.svg", class: "svg-icon")
