.chat-screen
  .homepage
    .widget-chat-header
      = button_to widget_conversations_path(widget_route_params(format: :turbo_stream)), method: :get, class: "widget-chat-back", form: { data: { turbo_stream: true } } do
        = inline_svg_tag("back_arrow.svg", class: "widget-chat-back-icon")
      .widget-chat-header-avatars
        - @agents.each do |agent|
          - if agent.avatar.attached?
            = image_tag(agent.avatar.variant(:thumb), class: "widget-chat-avatar")
          - else
            .widget-chat-avatar.widget-chat-avatar-placeholder class=avatar_fallback_color_class(agent.display_name || agent.first_name || agent.email)
              = agent.display_name&.first&.upcase || "A"
      .widget-chat-header-text
        .widget-chat-team-name = t('widget.conversations.messages')
        .widget-chat-online
          span.widget-chat-online-dot
          = t('widget.chat.online', default: "Online")

    - if @customer && @inbox
      .main.main-content(
        data-controller="widget"
        data-widget-account-id-value=@account.id
        data-widget-widget-id-value=@widget.id
        data-widget-customer-session-token-value=customer_session_token
        data-widget-connection-token-value=@customer_inbox&.connection_token
        data-widget-unread-count-value=@unread_count
        data-widget-url-value=widget_create_message_path(widget_route_params(conversation_id: @conversation&.id))
        data-widget-conversation-data-value=(@pre_chat_conversation_data&.to_json if @pre_chat_conversation_data.present?)
      )
        .conversation#messages-list
          = render "widget/messages_pager"

          - if @messages.any?
            .widget-date-separator = t('widget.chat.today', default: "Today")
            = render partial: "widget/message", collection: @messages
          - else
            .time = Time.current.strftime("%a %l:%M %p")

        .send-msg
          - editor_i18n = { placeholder: t("widget.editor.placeholder"), emoji: t("widget.editor.emoji"), attach_file: t("widget.editor.attach_file"), send: t("widget.editor.send"), emoji_smileys: t("widget.editor.emoji_smileys"), emoji_gestures: t("widget.editor.emoji_gestures"), emoji_hearts: t("widget.editor.emoji_hearts"), emoji_objects: t("widget.editor.emoji_objects") }

          .de-container(data-editor-i18n=editor_i18n.to_json)

    - else
      = render "widget/pre_chat_form"
