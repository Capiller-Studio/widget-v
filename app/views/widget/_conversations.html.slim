.chat-screen
  .homepage
    .widget-page-header
      .widget-page-header-text
        h1 = t('widget.conversations.title')
        p = t('widget.conversations.subtitle', default: "All your conversations in one place.")
      / .widget-page-header-actions
      /   = button_to widget_messages_path(widget_route_params(format: :turbo_stream)), method: :get, class: "widget-new-conv-btn", form: { data: { turbo_stream: true } } do
      /     = inline_svg_tag("message.svg", class: "theme-svg")
    .widget-page-search
      span.widget-page-search-icon
        = inline_svg_tag("search.svg")
      input type="text" name="q" placeholder=t('widget.conversations.search_placeholder', default: "Search conversations...")
    .main.main-content
      .conversation-history#conversations-list
        - if @conversations.any?
          = render partial: "widget/conversation_item", collection: @conversations, as: :conversation
          = render "widget/conversations_pager"
        - else
          .empty-state
            p = t('widget.conversations.no_conversations')
    = render("footer", active: { message: "active" })
