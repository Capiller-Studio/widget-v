.chat-screen
  .homepage
    .header-1
      .svg-icons
        - @agents.each do |agent|
          - if agent.avatar.attached?
            = image_tag(agent.avatar.variant(:thumb), class: "person-img")
          - else
            .person-img.avatar-placeholder class=avatar_fallback_color_class(agent.display_name || agent.first_name || agent.email)
              = agent.display_name&.first&.upcase || "A"
      .header-text = t('widget.conversations.title')
    .main.main-gradient.main-content
      .conversation-history#conversations-list
        - if @conversations.any?
          = render partial: "widget/conversation_item", collection: @conversations, as: :conversation
          = render "widget/conversations_pager"
        - else
          .empty-state
            p = t('widget.conversations.no_conversations')
    = render("footer", active: { message: "active" })
