- if message.incoming?
  .client-reply class="#{'single-emoji-message' if single_emoji_message?(message.content)}"
    - if message.content.present?
      = message.content
    - if message.attachments.any?
      .msg-attachments
        - message.attachments.each do |attachment|
          - if attachment.audio? && attachment.file.attached?
            .msg-attachment-audio
              audio controls=true preload="metadata" src=rails_blob_path(attachment.file)
          - elsif attachment.image? && attachment.file.attached?
            .msg-attachment-img
              = image_tag(attachment.file, class: "attachment-image")
          - elsif attachment.file.attached?
            a.msg-attachment-file href=rails_blob_path(attachment.file, disposition: "attachment") target="_blank"
              span.file-icon 📄
              span.file-name = attachment.file.filename
- else
  .agent-msg
    - if message.sender.is_a?(User) && message.sender.avatar.attached?
      = image_tag(message.sender.avatar.variant(:thumb), class: "person-img")
    - else
      .person-img.avatar-placeholder = message.sender.try(:display_name)&.first&.upcase || "A"
    .agent-reply class="#{'single-emoji-message' if single_emoji_message?(message.content)}"
      - if message.content.present?
        = single_emoji_message?(message.content) ? message.content.strip : message.content
      - if message.attachments.any?
        .msg-attachments
          - message.attachments.each do |attachment|
            - if attachment.audio? && attachment.file.attached?
              .msg-attachment-audio
                audio controls=true preload="metadata" src=rails_blob_path(attachment.file)
            - elsif attachment.image? && attachment.file.attached?
              .msg-attachment-img
                = image_tag(attachment.file, class: "attachment-image")
            - elsif attachment.file.attached?
              a.msg-attachment-file href=rails_blob_path(attachment.file, disposition: "attachment") target="_blank"
                span.file-icon 📄
                span.file-name = attachment.file.filename
