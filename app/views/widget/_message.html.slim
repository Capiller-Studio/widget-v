- has_attachments = message.attachments.any?
- if message.incoming?
  .client-reply id=dom_id(message) class="#{'single-emoji-message' if !has_attachments && single_emoji_message?(message.content)}"
    - if message.attachments.any?
      .msg-attachments
        - message.attachments.each do |attachment|
          - if attachment.audio? && attachment.file.attached?
            .msg-attachment-audio data-controller="audio-player"
              audio data-audio-player-target="audio" preload="metadata" src=rails_blob_path(attachment.file)
              .audio-player-controls
                button.audio-btn type="button" data-action="audio-player#toggle" data-audio-player-target="playButton"
                  span.audio-icon-wrap data-audio-player-target="playIcon"
                    = inline_svg_tag "play.svg", alt: "Play"
                .audio-waveform data-audio-player-target="waveform"
                button.audio-btn.audio-mute-btn type="button" data-action="audio-player#toggleMute" data-audio-player-target="muteButton"
                  span.audio-icon-wrap data-audio-player-target="muteIcon"
                    = inline_svg_tag "volume.svg", alt: "Mute"
              .audio-time data-audio-player-target="timeDisplay" 0:00
          - elsif attachment.image? && attachment.file.attached?
            .msg-attachment-img
              = image_tag(attachment.file, class: "attachment-image")
          - elsif attachment.file.attached?
            a.msg-attachment-file href=rails_blob_path(attachment.file, disposition: "attachment") target="_blank"
              span.file-icon 📄
              span.file-name = attachment.file.filename
    - if message.content.present?
      .msg-content = message.content
    .msg-time = message.created_at.strftime("%I:%M %p")
- else
  .agent-msg id=dom_id(message)
    .agent-reply class="#{'single-emoji-message' if !has_attachments && single_emoji_message?(sanitize(message.content, tags: %w(p b i em strong s strike span code pre ul ol li br a), attributes: %w(class style href target rel dir spellcheck value)))}"
      - if message.attachments.any?
        .msg-attachments
          - message.attachments.each do |attachment|
            - if attachment.audio? && attachment.file.attached?
              .msg-attachment-audio data-controller="audio-player"
                audio data-audio-player-target="audio" preload="metadata" src=rails_blob_path(attachment.file)
                .audio-player-controls
                  button.audio-btn type="button" data-action="audio-player#toggle" data-audio-player-target="playButton"
                    span.audio-icon-wrap data-audio-player-target="playIcon"
                      = inline_svg_tag "play.svg", alt: "Play"
                  .audio-waveform data-audio-player-target="waveform"
                  button.audio-btn.audio-mute-btn type="button" data-action="audio-player#toggleMute" data-audio-player-target="muteButton"
                    span.audio-icon-wrap data-audio-player-target="muteIcon"
                      = inline_svg_tag "volume.svg", alt: "Mute"
                .audio-time data-audio-player-target="timeDisplay" 0:00
            - elsif attachment.image? && attachment.file.attached?
              .msg-attachment-img
                = image_tag(attachment.file, class: "attachment-image")
            - elsif attachment.file.attached?
              a.msg-attachment-file href=rails_blob_path(attachment.file, disposition: "attachment") target="_blank"
                span.file-icon 📄
                span.file-name = attachment.file.filename
      - if message.content.present?
        .msg-content
          = single_emoji_message?(sanitize(message.content, tags: %w(p b i em strong s strike span code pre ul ol li br a), attributes: %w(class style href target rel dir spellcheck value))) ? strip_tags(message.content).strip : sanitize(message.content, tags: %w(p b i em strong s strike span code pre ul ol li br a), attributes: %w(class style href target rel dir spellcheck value))
      .msg-time
        span = message.created_at.strftime("%I:%M %p")
