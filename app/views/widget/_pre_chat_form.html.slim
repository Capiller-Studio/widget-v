.chat-screen
  .homepage
    .header-1
      .header-text = @widget&.pre_chat_title.presence || t('widget.pre_chat.title', default: 'Start a Conversation')
    .main.main-gradient.main-content
      .pre-chat-form
        p.pre-chat-subtitle = @widget&.pre_chat_subtitle.presence || t('widget.pre_chat.subtitle', default: "We'd love to hear from you. Please share your details to get started.")
        = form_tag create_customer_path, method: :post, data: { turbo_stream: true }, class: "pre-chat-fields" do
          - if @widget&.pre_chat_form&.custom_fields&.any?
            - @widget.pre_chat_form.custom_fields.order(:position).each do |field|
              .field-group
                label for="custom_field_#{field.key}"
                  = field.label.presence || field.key.titleize
                  - if field.required?
                    span.required *
                - case field.field_type
                - when "select"
                  select id="custom_field_#{field.key}" name="custom_fields[#{field.key}]" required=field.required?
                    option value="" Select...
                    - field.localized_options(I18n.locale).each do |opt|
                      option value=opt["value"] = opt["label"]
                - when "textarea"
                  textarea id="custom_field_#{field.key}" name="custom_fields[#{field.key}]" required=field.required?
                - else
                  - input_type = ["email", "number", "url", "date", "phone"].include?(field.field_type) ? field.field_type : "text"
                  - input_type = "tel" if input_type == "phone"
                  input id="custom_field_#{field.key}" type=input_type name="custom_fields[#{field.key}]" required=field.required?
          - else
            .field-group
              label for="pre_chat_name"
                = t('widget.pre_chat.name', default: 'Your Name')
              input#pre_chat_name type="text" name="name" placeholder=t('widget.pre_chat.name_placeholder', default: 'Jane Doe') required=true
            .field-group
              label for="pre_chat_email"
                = t('widget.pre_chat.email', default: 'Email Address')
              input#pre_chat_email type="email" name="email" placeholder=t('widget.pre_chat.email_placeholder', default: 'you@example.com') required=true
          button.start-conv-btn type="submit"
            = t('widget.pre_chat.submit', default: 'Start Chat')
            = inline_svg_tag("send.svg")
    = render("footer", active: { message: "active" })
