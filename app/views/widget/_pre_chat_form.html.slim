.chat-screen
  .homepage
    - pre_chat_form = @widget&.pre_chat_form
    - pre_chat_custom_fields = @pre_chat_custom_fields || []
    .header-1
      .header-text = pre_chat_form&.title.presence || @widget&.pre_chat_title.presence || t("widget.pre_chat.title")
    .main.main-gradient.main-content.pre-chat-main
      .pre-chat-form
        p.pre-chat-subtitle = pre_chat_form&.subtitle.presence || @widget&.pre_chat_subtitle.presence || t("widget.pre_chat.subtitle")
        = form_tag widget_create_customer_path(widget_route_params), method: :post, data: { turbo_stream: true }, class: "pre-chat-fields" do
          - if pre_chat_custom_fields.any?
            - pre_chat_custom_fields.each do |field|
              - label_text = field.label.presence || field.key.titleize
              - placeholder_text = field.placeholder
              .field-group
                label for="custom_field_#{field.key}"
                  = label_text
                  - if field.required?
                    span.required *
                - case field.field_type
                - when "select"
                  select id="custom_field_#{field.key}" name="custom_fields[#{field.key}]" required=field.required?
                    option value="" Select...
                    - field.localized_options(I18n.locale).each do |opt|
                      option value=opt["value"] = opt["label"]
                - when "textarea"
                  textarea id="custom_field_#{field.key}" name="custom_fields[#{field.key}]" placeholder=placeholder_text required=field.required?
                - else
                  - input_type = ["email", "number", "url", "date", "phone"].include?(field.field_type) ? field.field_type : "text"
                  - input_type = "tel" if input_type == "phone"
                  input id="custom_field_#{field.key}" type=input_type name="custom_fields[#{field.key}]" placeholder=placeholder_text required=field.required?
          - else
            .field-group
              label for="pre_chat_name"
                = t("widget.pre_chat.name")
              input#pre_chat_name type="text" name="name" placeholder=t("widget.pre_chat.name_placeholder") required=true
            .field-group
              label for="pre_chat_email"
                = t("widget.pre_chat.email")
              input#pre_chat_email type="email" name="email" placeholder=t("widget.pre_chat.email_placeholder") required=true
          button.start-conv-btn type="submit"
            = pre_chat_form&.submit_button_text.presence || t("widget.pre_chat.submit")
            = inline_svg_tag("send.svg")
    = render("footer", active: { message: "active" })
