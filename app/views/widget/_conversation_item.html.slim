= button_to messages_path(conversation_id: conversation.id, format: :turbo_stream), method: :get, class: "conv-item", form: { data: { turbo_stream: true } } do
  .conv-details
    .title = conversation.title || "Conversation ##{conversation.identifier.last(4)}"
    .last-msg = conversation.messages.last&.content&.truncate(40) || t('widget.conversations.no_messages')
