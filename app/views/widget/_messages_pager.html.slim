- if @conversation && @pagy&.next
  = turbo_frame_tag "messages_pager", src: messages_path(conversation_id: @conversation.id, page: @pagy.next, format: :turbo_stream), loading: :lazy do
    .empty-state
      p = t('widget.messages.loading_older', default: 'Loading older messages...')
- else
  = turbo_frame_tag "messages_pager"

