.chat-screen 
  .homepage
    .header-2
      .logo
        = image_tag("logo.png", alt: "deskbolic image")
      .intro-heading
        = @widget.welcome_title.presence || t('widget.home.title')
      .intro-heading-addons
        .svg-icons
          - @all_agents.each do |agent|
            - if agent.avatar.attached?
              = image_tag(agent.avatar.variant(:thumb), class: "person-img")
            - else
              .person-img.avatar-placeholder class=avatar_fallback_color_class(agent.display_name || agent.first_name || agent.email)
                = agent.display_name&.first&.upcase || "A"
        .team = t('widget.home.team')
      .intro-subheading
        = @widget.welcome_tagline.presence || t('widget.home.subheading')
    .main 
      .start-conv
        .heading = t('widget.home.start_conversation')
        .sub-heading
          .svg-icons
            - @all_agents.each do |agent|
              - if agent.avatar.attached?
                = image_tag(agent.avatar.variant(:thumb), class: "person-img")
              - else
                .person-img.avatar-placeholder class=avatar_fallback_color_class(agent.display_name || agent.first_name || agent.email)
                  = agent.display_name&.first&.upcase || "A"
          .reply-time
            = t('widget.home.reply_time')
            .time
              = inline_svg_tag("message.svg", class: "theme-svg")
              = t('widget.home.reply_time_unit')
        = button_to messages_path(format: :turbo_stream), method: :get, class: "start-conv-btn", form: { data: { turbo_stream: true } } do
          p = t('widget.home.start_conversation')
          = inline_svg_tag("send.svg")
    = render("footer", active: { home: "active" })