- if @query.present?
  - if @categories.any?
    .widget-category-list
      = render partial: "widget/category_item", collection: @categories, as: :category

  - if @articles.any?
    .widget-article-list
      - @articles.each do |article|
        - article_category = article.primary_category || article.categories.first
        - if article_category
          = link_to widget_help_article_path(widget_route_params(category_id: article_category.id, article_id: article.id, format: :turbo_stream)), class: "widget-article-row", data: { turbo_stream: true } do
            .widget-icon-chip.widget-icon-chip--brand
              = category_icon_svg(article_category)
            .widget-article-row-text
              .widget-article-title = article.title.presence || t('widget.help_center.untitled', default: "Untitled")
              .widget-article-desc = strip_tags(article.content.to_s).strip.truncate(80)
            .widget-chevron ›

  - if @categories.blank? && @articles.blank?
    .empty-state
      p = t('widget.help_center.no_results')
