    "@lexical/history": "^0.44.0",
    "@lexical/html": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/selection": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "lexical": "^0.44.0",
    "postcss": "^8.5.1",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "postcss-mixins": "^11.0.3",
    "postcss-nesting": "^13.0.1",
    "postcss-simple-vars": "^7.0.1"
  }
