# ============================================================================
# Deskbolic Core — Environment Variables (.env)
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# IMPORTANT: .env is gitignored and should NEVER be committed.
# Only .env.sample (this file) is version-controlled.
#
# CONVENTION:
#   - ENV variables → infrastructure config (URLs, ports, hostnames, feature flags)
#   - Rails credentials → secrets (passwords, API keys, tokens, signing keys)
#   See config/credentials.yml.enc.sample for the credentials structure.
# ============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# Used in development/test only. Production uses Rails credentials.
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost

# ─── Elasticsearch / Searchkick ──────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
ANYCABLE_REDIS_URL=redis://localhost:6379/2
SIDEKIQ_REDIS_URL=redis://localhost:6379/1

# ─── Self-Hosted Translator (LibreTranslate) ─────────────────────────────────
OS_TRANSLATOR_URL=http://localhost:5001/translate

# ─── Rails ───────────────────────────────────────────────────────────────────
# RAILS_LOG_LEVEL=debug
# RAILS_MAX_THREADS=3
# PORT=3000

# ─── WebPush / VAPID ─────────────────────────────────────────────────────────
# VAPID_SUBJECT=mailto:info@deskbolic.com

# ─── Sidekiq ─────────────────────────────────────────────────────────────────
# SIDEKIQ_CONCURRENCY=5

# ─── Wise Payouts (Overrides) ────────────────────────────────────────────────
# To force mock payouts in development instead of hitting the sandbox API:
# MOCK_WISE_PAYOUTS=true

# ─── Static Asset Serving ────────────────────────────────────────────────────
# Set to true to let Puma serve static files from /public. (Recommended for MVP)
# RAILS_SERVE_STATIC_FILES=true

# ─── AWS S3 & CloudFront (Optional CDN) ──────────────────────────────────────
# Uncomment these when you want to use a CDN to serve assets and user uploads
# CDN_HOST=https://cdn.deskbolic.com
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=us-east-1
# AWS_BUCKET=deskbolic-production



# ─── Frontend App ────────────────────────────────────────────────────────────
FRONTEND_URL=https://app.deskbolic.com

# ─── Service URLs ────────────────────────────────────────────────────────────
# Used by various apps to generate absolute cross-app links and configure CORS/iframes
DESKBOLIC_URL=https://app.deskbolic.com
MARKETING_URL=https://deskbolic.com
HELPBOLIC_URL=https://helpbolic.com
GATEWAY_URL=https://api.deskbolic.com
CONSOLE_URL=https://console.deskbolic.com
PARTNERS_URL=https://partners.deskbolic.com
WIDGET_APP_URL=https://widget.deskbolic.com
WIDGET_BASE_URL=https://widget.deskbolic.com
FRONTEND_URL=https://app.deskbolic.com

# ─── Application Settings ────────────────────────────────────────────────────
DISABLE_REGISTRATION=false
MOBILE_APP_SECRET=your_mobile_app_secret
JOB_CONCURRENCY=5
